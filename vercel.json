{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sync?run=true",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/scoutlyst-import?run=true",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/world-cup?run=true",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/player-availabilities?run=true",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/prediction-snapshots?run=true",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/glpm-sportmonks-refresh-schedules?run=true",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/glpm-standings-refresh?run=true",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/glpm-upcoming-predictions?run=true",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/glpm-sportmonks-refresh-teams?run=true",
      "schedule": "30 4 * * 1"
    },
    {
      "path": "/api/cron/glpm-sportmonks-refresh-players?run=true",
      "schedule": "0 5 1 * *"
    },
    {
      "path": "/api/cron/glpm-sportmonks-refresh-coaches?run=true",
      "schedule": "30 5 1 * *"
    }
  ]
}
