{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --prefix match-predictor",
  "buildCommand": "npm run build --prefix match-predictor",
  "crons": [
    {
      "path": "/api/cron/sync?run=true",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/scoutlyst-import?run=true",
      "schedule": "0 7 * * 1"
    }
  ]
}
