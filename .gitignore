# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.venv-ml/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Scoutlyst CSV exports (keep folder structure via .gitkeep)
/data/imports/scoutlyst/incoming/**/*.csv
/data/imports/scoutlyst/archive/**/*.csv

# Local GLPM training / report artifacts (regenerable)
/data/reports/**
!/data/reports/.gitkeep
/data/knowledge/
/docs/*.pdf
/export/*.pdf
/export/glpm-league-run-*.html
/export/wc-graham-model-algorithm.pdf

# Local squad HTML re-import dumps (runtime uses sofifa-squads.json + Supabase)
/data/world-cup-2026/WC Squads/**
!/data/world-cup-2026/WC Squads/.gitkeep
/data/world-cup-2026/WC Squads - SoFIFA/**
!/data/world-cup-2026/WC Squads - SoFIFA/.gitkeep

# Local Opta HTML saves (ingest input — parsed data lives in Supabase after wc:postmatch)
/data/world-cup-2026/WC-Opta-Results/**
/data/world-cup-2026/WC-Opta-Player-Stats/**
!/data/world-cup-2026/WC-Opta-Results/.gitkeep
!/data/world-cup-2026/WC-Opta-Player-Stats/.gitkeep

# Local Nations League squad / Opta HTML saves (ingest input — parsed data in Supabase after nl:postmatch)
/data/nations-league-2026/NL Squads/**
!/data/nations-league-2026/NL Squads/.gitkeep
/data/nations-league-2026/NL-Opta-Results/**
/data/nations-league-2026/NL-Opta-Player-Stats/**
!/data/nations-league-2026/NL-Opta-Results/.gitkeep
!/data/nations-league-2026/NL-Opta-Player-Stats/.gitkeep
!/data/nations-league-2026/NL-Opta-Player-Stats/Match Summary/.gitkeep
!/data/nations-league-2026/NL-Opta-Player-Stats/Opta Summary/.gitkeep
!/data/nations-league-2026/NL-Opta-Player-Stats/Match Details/.gitkeep

# Local FBref / FIFA scrape exports (not committed)
/data/imports/fbref/**/*.html
/data/imports/fbref/**/*.htm
/data/imports/fbref/**/*_files/**
/data/imports/statz/**/*.html
/data/imports/fifa/**/*
!/data/imports/fifa/**/.gitkeep
!/data/imports/fifa/fifa-rankings-2026.json
!/data/imports/fifa/README.md
/data/imports/footystats/**/*.csv
/data/imports/martj42/**/*.csv
!/data/imports/footystats/.gitkeep
!/data/imports/martj42/.gitkeep
!/data/imports/fbref/nations-league/.gitkeep

# Misplaced FBref / lineup HTML dumps under NL data root (JSON + gitkeeps are committed)
/data/nations-league-2026/**/*.html
/data/nations-league-2026/**/*_files/**
!/data/nations-league-2026/NL Bulin Predicted Starting/manifest-md1.json
!/data/nations-league-2026/NL Bulin Predicted Starting/predicted-xis-md1.json

# misc
.DS_Store
*.pem
__pycache__/
*.pyc
.Rhistory

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI temp
/supabase/.temp/
