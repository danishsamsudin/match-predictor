# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.venv-ml/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Scoutlyst CSV exports (keep folder structure via .gitkeep)
/data/imports/scoutlyst/incoming/**/*.csv
/data/imports/scoutlyst/archive/**/*.csv

# Local Opta HTML saves (ingest input — parsed data lives in Supabase after wc:postmatch)
/data/world-cup-2026/WC-Opta-Results/**
/data/world-cup-2026/WC-Opta-Player-Stats/**
!/data/world-cup-2026/WC-Opta-Results/.gitkeep
!/data/world-cup-2026/WC-Opta-Player-Stats/.gitkeep

# Local FBref / FIFA scrape exports (not committed)
/data/imports/fbref/**/*.html
/data/imports/fbref/**/*.htm
/data/imports/fifa/**/*
!/data/imports/fifa/**/.gitkeep
!/data/imports/fifa/fifa-rankings-2026.json
!/data/imports/fifa/README.md

# misc
.DS_Store
*.pem
__pycache__/
*.pyc
.Rhistory

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local GLPM training / report artifacts (regenerable)
/data/reports/.glpm-artifact-snapshots/
/data/reports/.glpm-introspection-*.json
/data/reports/.glpm-league-run-*-summaries.json
/export/glpm-league-run-*.html
