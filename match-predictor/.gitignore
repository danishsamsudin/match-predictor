# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Scoutlyst CSV exports (keep folder structure via .gitkeep)
/data/imports/scoutlyst/incoming/**/*.csv
/data/imports/scoutlyst/archive/**/*.csv

# Local FBref / FIFA scrape exports (not committed)
/data/imports/fbref/**/*.html
/data/imports/fbref/**/*.htm
/data/imports/fifa/**/*
!/data/imports/fifa/**/.gitkeep
!/data/imports/fifa/fifa-rankings-2026.json
!/data/imports/fifa/README.md

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
