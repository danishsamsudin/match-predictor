{
  "name": "match-predictor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "logos:download": "node scripts/download-team-logos.mjs",
    "logos:download:force": "node scripts/download-team-logos.mjs --force",
    "logos:repair": "node scripts/repair-team-logos.mjs",
    "cities:generate": "node scripts/generate-team-cities.mjs",
    "test:live": "bash scripts/test-live-apis.sh",
    "soccerdata:install": "python3 -m pip install -r services/soccerdata/requirements.txt",
    "soccerdata:populate": "bash scripts/soccerdata-populate.sh",
    "scoutlyst:import": "bash scripts/scoutlyst-import.sh",
    "scoutlyst:import:direct": "npx tsx scripts/run-scoutlyst-import.ts",
    "lineups:backfill": "npx tsx scripts/backfill-event-lineups.ts",
    "seed:sofascore": "python3 seed_database.py",
    "stats:backfill": "python3 scripts/backfill_event_statistics.py platform 0",
    "stats:backfill:batch": "python3 scripts/backfill_event_statistics.py platform 500",
    "stats:backfill:leagues": "python3 scripts/backfill_event_statistics.py all 0",
    "formations:backfill": "npx tsx scripts/backfill-fbref-match-formations.ts",
    "formations:sync": "npx tsx scripts/sync-team-formations.ts",
    "squad:diagnose": "npx tsx scripts/diagnose-squad-data.ts",
    "fifa:import": "python3 scripts/import_fifa_rankings.py",
    "fifa:json": "npx tsx scripts/generate-fifa-rankings-json.ts",
    "parse:fifa-squads": "python3 scripts/parse_fifa_world_cup_squad_pdf.py",
    "wc:matrix": "npx tsx scripts/import-fifa-third-place-matrix.ts",
    "wc:groups": "npx tsx scripts/seed-world-cup-groups-json.ts",
    "wc:venues": "npx tsx scripts/seed-world-cup-fixture-venues.ts",
    "wc:sync": "bash scripts/wc-sync.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "axios": "^1.16.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
